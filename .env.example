VITE_TESTNET_CONTRACT=0x0D90E98C9Fc63FDb62843F546E578CF237d91FD9
VITE_MAINNET_CONTRACT=
# Public HTTPS metadata API, leave empty for same-origin /api in local development.
VITE_API_URL=
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Restrict to your website origin when the API is hosted separately.
ALLOWED_ORIGIN=http://127.0.0.1:5173

# Server-only. Never prefix the Gemini key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Keep disabled for local development. Public AI needs access controls and quotas.
AI_ALLOW_REMOTE=false
AI_DAILY_LIMIT=50

# Production deployment (Docker Compose uses DOMAIN for Caddy HTTPS).
DOMAIN=
PUBLIC_URL=
# Comma-separated public wallet addresses allowed to use public Gemini.
AI_ALLOWED_WALLETS=
AI_WALLET_DAILY_LIMIT=10
METADATA_MAX_BYTES=104857600
METADATA_MAX_FILES=10000
METADATA_DAILY_LIMIT=500
METADATA_WALLET_DAILY_LIMIT=20
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=6
