# Supabase dashboard: Edge Functions > Secrets.
# Local Supabase stack: copy this file to supabase/functions/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PUBLIC_URL=https://motochain-hackathon-ssn31pny5-afif-luthfi06.vercel.app
# All valid EVM wallets can sign in; signatures and daily quotas remain required.
AI_DAILY_LIMIT=50
AI_WALLET_DAILY_LIMIT=10
METADATA_MAX_BYTES=104857600
METADATA_MAX_FILES=10000
METADATA_DAILY_LIMIT=500
METADATA_WALLET_DAILY_LIMIT=20
# SUPABASE_URL and backend keys are supplied by the Edge runtime.
# Never copy secret/service_role keys into VITE_ variables.
