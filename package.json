{
  "name": "motochain-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "node scripts/compile.js && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.js",
    "compile": "node scripts/compile.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "ganache": "^7.9.2",
    "prettier": "^3.9.9",
    "solc": "0.8.30",
    "vite": "^7.1.0"
  }
}
